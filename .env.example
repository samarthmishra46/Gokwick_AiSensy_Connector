# Copy to .env for local `vercel dev`, and add the same variables in
# Vercel -> Project -> Settings -> Environment Variables for production.
# Never commit real values. Empty values count as "not set".

# --- Required ---------------------------------------------------------------

# Long random string (letters/digits only). It goes in the GoKwik webhook URL.
# Generate one with:  openssl rand -hex 32
GOKWIK_WEBHOOK_TOKEN=

# From AiSensy -> Manage -> API Key. Required once DRY_RUN=false.
AISENSY_API_KEY=

# Exact name of the Live API campaign in AiSensy. Required once DRY_RUN=false.
AISENSY_CAMPAIGN_NAME=

# --- Message ----------------------------------------------------------------

AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2

# Values for the template's {{1}}, {{2}}, ... in this order.
# Allowed: first_name, recovery_url, cart_total, items_summary, store_name
AISENSY_TEMPLATE_PARAMS=first_name,recovery_url

# Optional. Only if your template has a URL *button* with a dynamic part, e.g.
# https://www.themisstt.com/{{1}}. Sends the recovery link's path as the suffix.
# See README "Link in body vs. button" before using.
# AISENSY_BUTTON_URL_SUFFIX_FROM=recovery_url_path

# Used when a cart has no first name.
FALLBACK_NAME=there
STORE_NAME="THE MISSTT"

# Used as the link when a cart has no recovery link (unless REQUIRE_RECOVERY_LINK=true).
STORE_URL=https://www.themisstt.com
# true = skip carts without a GoKwik recovery link instead of sending STORE_URL.
REQUIRE_RECOVERY_LINK=false

# Added to 10-digit numbers.
DEFAULT_COUNTRY_CODE=91

# --- Safety switches (start safe) ----------------------------------------------

# true = never call AiSensy; log the message that would be sent.
DRY_RUN=true

# true = send nothing; log the shape of GoKwik payloads (no customer data).
DISCOVERY_MODE=true

# --- Test endpoint (/api/test-send) --------------------------------------------

# Another long random string, different from GOKWIK_WEBHOOK_TOKEN.
# Also lets you trigger /api/cron/retry-failed by hand (?token=...).
ADMIN_TOKEN=

# Your own WhatsApp number, e.g. 98XXXXXXXX.
TEST_PHONE=

# --- Redis (Upstash): duplicate protection, already-ordered check, retries -------

# Without these: a GoKwik retry could send the same customer two messages, the
# already-ordered check can't work, and failed sends aren't kept for retry.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How long a cart is remembered as "sent" (seconds). 172800 = 48 h.
DEDUPE_TTL_SECONDS=172800

# --- Already-ordered check (Shopify "Order creation" webhook) ----------------------

# Shopify admin -> Settings -> Notifications -> Webhooks: the signing key shown under
# the webhook list ("Your webhooks will be signed with ..."). See README step 4b.
SHOPIFY_WEBHOOK_SECRET=

# How long an order suppresses abandoned-cart messages to the same phone. 86400 = 24 h.
ORDER_SUPPRESS_SECONDS=86400

# --- Retry queue (/api/cron/retry-failed) ------------------------------------------

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" when this is set (16+ chars).
CRON_SECRET=

# AiSensy attempts per cart before giving up (also stops after 24 h).
RETRY_MAX_ATTEMPTS=6

# --- Optional: field overrides after discovery -----------------------------------

# Dot-paths inside one cart, e.g. customer.phone or line_items.0.title
MAP_PHONE=
MAP_NAME=
MAP_LINK=
MAP_CART_ID=
MAP_TOTAL=

# Optional event filter. Only if discovery shows GoKwik sends a state/event field:
# MAP_EVENT_TYPE = its path; ALLOWED_EVENT_TYPES = comma list of values that mean
# "abandoned" (case-insensitive). Carts with any other value are skipped.
MAP_EVENT_TYPE=
ALLOWED_EVENT_TYPES=
